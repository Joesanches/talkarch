# Push-шлюз в контуре (docs/03-architecture.md, раздел 6). Запуск в окружении разработчика: pnpm dev:push
# Сервер сообщений из infra/ ходит к шлюзу на http://host.docker.internal:8075/_matrix/push/v1/notify.
PUSH_HOST=0.0.0.0
PUSH_PORT=8075
# Вне сети организации: off — никуда; critical — только критические находки и звонки; all — всё (сигнал без содержимого).
PUSH_EXTERNAL=off
PUSH_ACK_TIMEOUT_MS=3000
PUSH_HEARTBEAT_MS=25000
# Тексты на экране блокировки — без отправителя и текста сообщения.
PUSH_TITLE=Консилиум
PUSH_TEXT_MESSAGE=Новое сообщение
PUSH_TEXT_CRITICAL=Критическая находка — требуется подтверждение
PUSH_TEXT_CALL=Входящий звонок
# APNs (iOS): ключ .p8 из Apple Developer.
# APNS_KEY_FILE=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=
# FCM HTTP v1 (Android): JSON сервисного аккаунта Firebase.
# FCM_SERVICE_ACCOUNT_FILE=
# RuStore Push (Android).
# RUSTORE_PROJECT_ID=
# RUSTORE_SERVICE_TOKEN=
