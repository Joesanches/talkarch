{
  "name": "@konsilium/web",
  "version": "0.1.0",
  "private": true,
  "description": "Веб-клиент «Консилиума»: оболочка мессенджера и чат случая (React + matrix-js-sdk)",
  "type": "module",
  "scripts": {
    "dev": "vite",
