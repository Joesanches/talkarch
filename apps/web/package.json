    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@konsilium/host-mock": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.7"
  }
}
