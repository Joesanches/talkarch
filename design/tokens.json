{
  "$description": "Дизайн-токены «Консилиум» (рабочее название). Формат близок к W3C Design Tokens (DTCG). Значения — заглушки до получения брендбука. Производные цвета вычисляются формулой из brand.accent (см. $extensions.ru.vendor.derive); значения $value даны для пресета clinical-blue.",
  "brand": {
    "accent": { "$type": "color", "$value": "#1F6FB2", "$description": "Единственный обязательный цвет бренда" },
    "font": {
      "ui": { "$type": "fontFamily", "$value": ["Golos Text", "Segoe UI", "system-ui", "sans-serif"], "$description": "Заглушка (OFL, кириллица); заменяется корпоративным шрифтом" },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Номера исследований, коды, технические поля" }
    }
  },
  "color": {
    "accent": {
      "base": { "$type": "color", "$value": "{brand.accent}" },
      "text": { "$type": "color", "$value": "#1A5E97", "$extensions": { "ru.vendor.derive": "mix({brand.accent}, #000000, 0.15)" }, "$description": "Ссылки и активные подписи на светлом фоне" },
      "soft": { "$type": "color", "$value": "#E4EEF6", "$extensions": { "ru.vendor.derive": "mix({brand.accent}, #FFFFFF, 0.88)" }, "$description": "Выделенная строка, активная папка, тональные кнопки" }
    },
    "bubble": {
      "in": { "$type": "color", "$value": "#FFFFFF" },
      "out": { "$type": "color", "$value": "#DDE9F3", "$extensions": { "ru.vendor.derive": "mix({brand.accent}, #FFFFFF, 0.85)" } },
      "out-meta": { "$type": "color", "$value": "#164E7D", "$extensions": { "ru.vendor.derive": "mix({brand.accent}, #000000, 0.30)" }, "$description": "Время, галочки и подписи в исходящем пузыре" },
      "quote": { "$type": "color", "$value": "#EEF3F8", "$description": "Фон цитаты ответа" }
    },
    "neutral": {
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-muted": { "$type": "color", "$value": "#F1F4F7" },
      "rail": { "$type": "color", "$value": "#EBEFF4", "$description": "Рейка папок на десктопе" },
      "chat-wallpaper": { "$type": "color", "$value": "#E7ECF1", "$description": "Фон ленты; поверх — точечная сетка rgba(23,49,79,0.11), шаг 20 px" },
      "border": { "$type": "color", "$value": "#E1E7ED" },
      "border-strong": { "$type": "color", "$value": "#D5DDE5" },
      "text": { "$type": "color", "$value": "#16202B" },
      "text-secondary": { "$type": "color", "$value": "#4E5A68" },
      "text-meta": { "$type": "color", "$value": "#5F6B7A" },
      "icon-muted": { "$type": "color", "$value": "#7D8996" }
    },
    "semantic": {
      "critical": { "$type": "color", "$value": "#C62828" },
      "critical-text": { "$type": "color", "$value": "#A3191B" },
      "critical-soft": { "$type": "color", "$value": "#FDE8E8" },
      "critical-border": { "$type": "color", "$value": "#E3A4A4" },
      "danger-button": { "$type": "color", "$value": "#B42318", "$description": "Кнопка «Подтвердить получение»" },
      "warning-text": { "$type": "color", "$value": "#864700" },
      "warning-soft": { "$type": "color", "$value": "#FFF1DD" },
      "success-text": { "$type": "color", "$value": "#17663A" },
      "success-soft": { "$type": "color", "$value": "#E6F4EA" },
      "online": { "$type": "color", "$value": "#1F9D55" },
      "annotation": { "$type": "color", "$value": "#FFD43B", "$description": "Разметка на снимках и препаратах" }
    },
    "kind": {
      "$description": "Цвет аватара подсказывает тип и источник чата",
      "pathology": { "$type": "color", "$value": "#9D2A5E" },
      "radiology": { "$type": "color", "$value": "#334155" },
      "service": { "$type": "color", "$value": "#B45309" },
      "consilium": { "$type": "color", "$value": "#4338CA" },
      "external": { "$type": "color", "$value": "#0F766E" },
      "channel": { "$type": "color", "$value": "#1F5F8B" },
      "saved": { "$type": "color", "$value": "#475569" }
    },
    "avatar": {
      "$description": "Палитра аватаров людей; белые инициалы ≥ 4,9:1",
      "1": { "$type": "color", "$value": "#C2410C" },
      "2": { "$type": "color", "$value": "#BE185D" },
      "3": { "$type": "color", "$value": "#0F766E" },
      "4": { "$type": "color", "$value": "#4338CA" },
      "5": { "$type": "color", "$value": "#0369A1" },
      "6": { "$type": "color", "$value": "#15803D" },
      "7": { "$type": "color", "$value": "#A16207" },
      "8": { "$type": "color", "$value": "#475569" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#0E141B" },
      "surface": { "$type": "color", "$value": "#18212B" },
      "control": { "$type": "color", "$value": "#26313D" },
      "chat-wallpaper": { "$type": "color", "$value": "#121A23" },
      "bubble-in": { "$type": "color", "$value": "#1E2833" },
      "bubble-out": { "$type": "color", "$value": "#174267", "$extensions": { "ru.vendor.derive": "mix({brand.accent}, #0E141B, 0.50)" } },
      "bubble-out-meta": { "$type": "color", "$value": "#B9C6D3" },
      "text": { "$type": "color", "$value": "#E8EEF4" },
      "text-secondary": { "$type": "color", "$value": "#9AA7B4" }
    }
  },
  "presets": {
    "$description": "Примеры пресетов бренда: все производные получены формулами выше; контраст проверен",
    "clinical-blue": { "accent": "#1F6FB2", "accent-text": "#1A5E97", "accent-soft": "#E4EEF6", "bubble-out": "#DDE9F3", "bubble-out-meta": "#164E7D", "dark-bubble-out": "#174267" },
    "teal": { "accent": "#0E7C6B", "accent-text": "#0C695B", "accent-soft": "#E2EFED", "bubble-out": "#DBEBE9", "bubble-out-meta": "#0A574B", "dark-bubble-out": "#0E4843" },
    "violet": { "accent": "#6E3FA3", "accent-text": "#5E368B", "accent-soft": "#EEE8F4", "bubble-out": "#E9E2F1", "bubble-out-meta": "#4D2C72", "dark-bubble-out": "#3E2A5F" },
    "terracotta": { "accent": "#B4532A", "accent-text": "#994724", "accent-soft": "#F6EAE5", "bubble-out": "#F4E5DF", "bubble-out-meta": "#7E3A1D", "dark-bubble-out": "#613423" }
  },
  "typography": {
    "title": { "$type": "typography", "$value": { "fontFamily": "{brand.font.ui}", "fontWeight": 600, "fontSize": "22px", "lineHeight": "28px" } },
    "chat-title": { "$type": "typography", "$value": { "fontFamily": "{brand.font.ui}", "fontWeight": 600, "fontSize": "15px", "lineHeight": "20px" } },
    "message": { "$type": "typography", "$value": { "fontFamily": "{brand.font.ui}", "fontWeight": 400, "fontSize": "14.5px", "lineHeight": "21px" }, "$description": "На мобильных 15/21" },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{brand.font.ui}", "fontWeight": 500, "fontSize": "12.5px", "lineHeight": "17px" } },
    "meta": { "$type": "typography", "$value": { "fontFamily": "{brand.font.ui}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px" } },
    "id": { "$type": "typography", "$value": { "fontFamily": "{brand.font.mono}", "fontWeight": 500, "fontSize": "14px", "lineHeight": "20px" } }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "bubble-tail": { "$type": "dimension", "$value": "5px", "$description": "Угол пузыря со стороны отправителя" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "touch": { "$type": "dimension", "$value": "44px", "$description": "Минимальная зона касания на мобильных" }
  },
  "elevation": {
    "bubble": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px", "color": "rgba(16, 35, 60, 0.08)" } },
    "popover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "48px", "spread": "0px", "color": "rgba(16, 35, 60, 0.28)" } }
  },
  "$extensions": {
    "ru.vendor.contrast": {
      "$description": "Проверка WCAG 2.1 (отношение контраста) для пресета clinical-blue",
      "white-on-accent": 5.28,
      "accent-text-on-white": 6.79,
      "accent-text-on-accent-soft": 5.78,
      "bubble-out-meta-on-bubble-out": 7.03,
      "text-on-bubble-out": 13.35,
      "text-meta-on-white": 5.43,
      "text-meta-on-surface-muted": 4.91,
      "white-on-muted-badge-#6B7785": 4.56,
      "white-on-critical": 5.62,
      "dark-text-on-dark-bg": 15.84,
      "dark-text-secondary-on-dark-bg": 7.55
    }
  }
}
