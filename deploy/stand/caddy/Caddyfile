# Единая точка входа стенда: HTTPS, веб-клиент, Synapse, сервис контекста, сигнализация LiveKit.
# DOMAIN и TLS_MODE (acme | internal) — из deploy/stand/.env; global.caddy (email для ACME) генерирует ./stand.sh init.
{
	import global.caddy
}

{$DOMAIN} {
	import tls-{$TLS_MODE:acme}.caddy
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
		# Встраивать чат во фрейм можно только своим страницам и РИС/ЛИС из EMBED_ORIGINS.
		Content-Security-Policy "frame-ancestors 'self' {$EMBED_ORIGINS}"
		-Server
	}

	# Обнаружение сервера для сторонних Matrix-клиентов (например, Element) — проверка совместимости.
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"https://{$DOMAIN}"}}`
	}

	# Matrix Client-Server API. Admin API Synapse (/_synapse/admin) наружу не публикуется.
	# Синхронизация при WORKERS=on — воркерам синхронизации (один пользователь — всегда на тот же воркер, там его кеш).
	handle /_matrix/* {
		@sync path_regexp ^/_matrix/client/((r0|v3)/sync|unstable/org\.matrix\.simplified_msc3575/sync|(api/v1|r0|v3)/events|(api/v1|r0|v3)/initialSync|(api/v1|r0|v3)/rooms/[^/]+/initialSync)$
		reverse_proxy @sync {$SYNAPSE_SYNC_UPSTREAMS:synapse:8008} {
			lb_policy header Authorization
		}
		reverse_proxy synapse:8008
	}
	handle /_synapse/client/* {
		reverse_proxy synapse:8008
	}

	# Сервис контекста: API клиентов и API интеграции для РИС/ЛИС (по токенам подключений).
	handle /api/* {
		reverse_proxy ccs:8080
	}
	handle /integration/* {
		reverse_proxy ccs:8080
	}

	# Единый вход: Keycloak (SSO=keycloak). Консоль администратора — /auth/admin, пароль — KC_ADMIN_PASSWORD в .env.
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Сигнализация звонков (WebSocket). Медиа идёт напрямую на LiveKit: UDP 7882, TCP 7881, TURN UDP 3478.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# SDK встраивания для страниц РИС/ЛИС на других доменах.
	handle /embed/v1/* {
		header Access-Control-Allow-Origin *
		root * /srv
		file_server
	}

	# Демо-страница РИС из песочницы (встраивание чата). Обратные вызовы песочницы наружу не публикуются.
	handle /sandbox/* {
		uri replace /sandbox/ /demo/ 1
		reverse_proxy host-mock:8090
	}

	# Веб-клиент; адреса серверов — в /config.json.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
