PUSH_HOST=0.0.0.0
PUSH_PORT=8075
# Push вне сети организации: off — только прямое соединение в сети организации (и через VPN); critical — через внешние
# сервисы только критические находки и звонки; all — всё. Во внешний сервис уходит только сигнал без содержимого.
PUSH_EXTERNAL=__PUSH_EXTERNAL__
# Внешние сервисы включаются ключами (файлы — в deploy/stand/generated/push-keys/, смонтированы в /config/push-keys):
# APNS_KEY_FILE=/config/push-keys/AuthKey.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=ru.vendor.konsilium
# FCM_SERVICE_ACCOUNT_FILE=/config/push-keys/fcm-service-account.json
# RUSTORE_PROJECT_ID=
# RUSTORE_SERVICE_TOKEN=
